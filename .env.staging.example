# Solo plantilla. Guárdela como $DEPLOY_PATH/shared/.env en el servidor staging.
DJANGO_ENV=staging
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=GENERAR_SECRETO_ALEATORIO_DE_MAS_DE_50_CARACTERES
DJANGO_ALLOWED_HOSTS=api-staging-fm.example.pe
CSRF_TRUSTED_ORIGINS=https://staging-fm.example.pe
CORS_ALLOWED_ORIGINS=https://staging-fm.example.pe
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

POSTGRES_DB=incalpaca_staging
POSTGRES_USER=incalpaca_staging
POSTGRES_PASSWORD=GENERAR_CONTRASENA_UNICA
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
HEALTH_CHECK_TOKEN=GENERAR_TOKEN_LARGO_PARA_MONITOREO
HEALTH_DISK_WARNING_PERCENT=80
HEALTH_DISK_CRITICAL_PERCENT=90
MONITORING_TLS_HOST=staging-fm.example.pe
MONITORING_TLS_PORT=443

PUBLIC_FRONTEND_URL=https://staging-fm.example.pe
NOTIFICATION_DISPATCH_ENABLED=1
DEFAULT_FROM_EMAIL=SGTB Staging <noreply@staging-fm.example.pe>
NOTIFICATION_MESSAGE_ID_DOMAIN=staging-fm.example.pe
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=CONFIGURAR_EN_GITHUB_O_GESTOR_DE_SECRETOS
BREVO_SMTP_PASSWORD=CONFIGURAR_EN_GITHUB_O_GESTOR_DE_SECRETOS
BREVO_SMTP_USE_TLS=1

BACKUP_HOST_PATH=/srv/incalpaca-staging/backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_VERIFY_RESTORE=1
BACKUP_EXTERNAL_TARGET=CONFIGURAR_DESTINO_RCLONE_AISLADO
BACKUP_RCLONE_CONFIG=/run/secrets/rclone.conf

# Destino de alertas externas del monitor del host (Teams, Slack, Make, etc.).
ALERT_WEBHOOK_URL=CONFIGURAR_WEBHOOK_SECRETO
NGINX_ACCESS_LOG=/var/log/nginx/incalpaca-staging.access.log
