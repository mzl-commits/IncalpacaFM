# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-local-secret

# PostgreSQL is the target database. Copy this file to .env before starting.
DB_ENGINE=postgresql
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=incalpaca_fm
POSTGRES_USER=incalpaca_fm
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=1
DB_APPLICATION_NAME=incalpaca-fm-local

# Correo transaccional Brevo. No copies valores reales al repositorio.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
BREVO_SMTP_USE_TLS=1
DEFAULT_FROM_EMAIL=SGTB Incalpaca <noreply@tu-dominio.pe>
NOTIFICATION_MESSAGE_ID_DOMAIN=tu-dominio.pe

# Procesamiento asíncrono de correos y reintentos.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
NOTIFICATION_DISPATCH_ENABLED=0

# DATABASE_URL can replace DB_ENGINE and all POSTGRES_* connection values.
# DATABASE_URL=postgresql://incalpaca_fm:password@127.0.0.1:5432/incalpaca_fm

# Correos de confirmacion para solicitudes publicas
PUBLIC_FRONTEND_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-clave-de-aplicacion-de-gmail
DEFAULT_FROM_EMAIL=SGTB Incalpaca <tu-correo@gmail.com>