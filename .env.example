# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
# Desarrollo: conserva los valores locales. Producción: use DJANGO_ENV=production,
# DEBUG=0, un secreto >= 50 caracteres y dominios HTTPS reales.
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0

# PostgreSQL is the target database. Copy this file to .env before starting.
DB_ENGINE=postgresql
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=incalpaca_fm
POSTGRES_USER=incalpaca_fm
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=1
DB_APPLICATION_NAME=incalpaca-fm-local

# Correo transaccional Brevo. No copies valores reales al repositorio.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
BREVO_SMTP_USE_TLS=1
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=SGTB Incalpaca <noreply@tu-dominio.pe>
NOTIFICATION_MESSAGE_ID_DOMAIN=tu-dominio.pe

# Procesamiento asíncrono de correos y reintentos.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
NOTIFICATION_DISPATCH_ENABLED=0

# Sondas internas de disponibilidad y alertas operativas.
# En producción use un valor aleatorio largo y configure el proxy/monitor para
# enviar X-Health-Token. Los endpoints ready y celery no deben exponerse abiertos.
HEALTH_CHECK_TOKEN=replace-with-a-long-random-monitoring-token
HEALTH_DISK_WARNING_PERCENT=80
HEALTH_DISK_CRITICAL_PERCENT=90
MONITORING_TLS_HOST=sgtb.tu-dominio.pe
MONITORING_TLS_PORT=443

# Backups: ejecución diaria, restauración de verificación y retención local.
# BACKUP_EXTERNAL_TARGET acepta un remoto configurado en rclone (S3, SFTP, etc.).
# No active la copia externa sin almacenar rclone.conf en un gestor de secretos.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_VERIFY_RESTORE=1
BACKUP_RPO_HOURS=24
BACKUP_EXTERNAL_TARGET=
BACKUP_RCLONE_CONFIG=/run/secrets/rclone.conf

# DATABASE_URL can replace DB_ENGINE and all POSTGRES_* connection values.
# DATABASE_URL=postgresql://incalpaca_fm:password@127.0.0.1:5432/incalpaca_fm

# URL pública usada en QR, reportes y correos de seguimiento.
PUBLIC_FRONTEND_URL=http://localhost:5173
